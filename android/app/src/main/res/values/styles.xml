<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- v5.53：targetSdk 35 强制 edge-to-edge，WebView 延伸到状态栏下——
             顶部菜单栏顶进双挖孔区且触摸被系统状态栏窗口消费（图标点不动）。
             opt-out 后 WebView 从状态栏下方开始渲染。API<35 平台忽略此项，无害。 -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>


    <!-- v9.5.6 启动页：正规启用 androidx SplashScreen（依赖早已引入但从未 install）。
         本 App 日夜=时间制（<07:00 或 >=19:00 夜，与 JS shouldBeDark 逐字同规则），
         不能靠系统 night 资源限定符，故 Day/Night 两显式变体由 MainActivity 开机 setTheme 选。
         windowBackground 换纯纸色（旧 @drawable/splash 位图退役）；postSplashScreenTheme 交回常规主题。
         v9.5.8 甲案：闪屏改纯纸底（AnimatedIcon=透明空图，必须显式给——缺省 A12+ 会回落 Launcher 图标），
         品牌只由原生幕布呈现一次，杜绝「系统环↔幕布环」双源位置跳动；上一代中央 1/3 安全区素材退役删除。 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/splash_bg_day</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_day</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Day" parent="AppTheme.NoActionBarLaunch" />

    <style name="AppTheme.NoActionBarLaunch.Night" parent="AppTheme.NoActionBarLaunch">
        <item name="android:background">@color/splash_bg_night</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_night</item>
    </style>
</resources>