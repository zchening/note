{
  "name": "@bj/client",
  "version": "1.0.0",
  "private": true,
  "description": "浏览器端：Lexical 编辑器 + 同步状态机 + UI 外壳。构建产物为 esbuild 单文件。",
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "build": "node ../../tools/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=6 test/e2e/*.test.js",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  },
  "dependencies": {
    "@lexical/code": "^0.52.0",
    "@lexical/extension": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "lexical": "^0.52.0"
  }
}
