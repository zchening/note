deploy_secrets.json
secrets.json

# 数据目录（含密文档与限流快照）
data/
data-bj/
*.data

# 构建产物（由 CI / 构建脚本物化）
www/
dist/
*.apk
*.aab

# 🔴 android/ **不入库忽略**：壳工程（含 9 个原生桥源）必须入库。
#   GitHub Actions 要靠仓库里的 android/ 出包；本机 `npx cap add android`
#   生成的是骨架，缺 Rem/ImgSave/ImgClip/LinkOpen/Update 五个桥与 MainActivity，
#   骨架编出来的 APK 能装能开，但提醒、存图、扫码原生加速、应用内升级全部失灵。
#   只忽略构建产物与本地签名材料。
android/build/
android/app/build/
android/.gradle/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/local.properties
android/app/*.p12
android/app/*.jks
android/app/*.keystore
android/captures/

# 依赖与缓存
node_modules/
.npm/
.pnpm-store/
*.tsbuildinfo

# Playwright
test-results/
playwright-report/
.playwright/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db
*.iml
*.log

# push_bj_apk.py 生成的本地元数据（真源在服务器 deploy/，不入库）
tools/latest_app.json
