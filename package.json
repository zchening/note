{
  "name": "notesync-bj",
  "version": "1.3.0",
  "private": true,
  "description": "NoteSync bj — 端到端加密笔记 PWA（模型 JSON 真源 + Lexical）",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/shared-schema",
    "packages/client",
    "packages/server",
    "packages/mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:schema": "npm run test --workspace @bj/shared-schema",
    "test:client": "npm run test --workspace @bj/client",
    "test:server": "npm run test --workspace @bj/server",
    "test:mcp": "npm run test --workspace @bj/mcp",
    "test": "npm run test:schema && npm run test:client && npm run test:server && npm run test:mcp",
    "test:e2e": "npm run test:e2e --workspace @bj/client",
    "test:e2e:live": "node --test --test-concurrency=1 packages/client/test/e2e-live/00-live.test.js 2>&1 | node tools/check-live-e2e.mjs",
    "build": "npm run build --workspace @bj/client",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fast-check": "3.23.2",
    "playwright": "^1.62.0",
    "typescript": "5.7.3",
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0"
  }
}
